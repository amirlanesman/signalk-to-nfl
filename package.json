{
  "name": "@noforeignland/signalk-to-noforeignland",
  "signalk": {
    "id": "@noforeignland/signalk-to-noforeignland",
    "displayName": "Signal K to Noforeignland",
    "appIcon": "./doc/logo/nfl-logo-red-round.png",
    "screenshots": [
      "./doc/screenshots/1_nfl_phone-8.jpg",
      "./doc/screenshots/2_nfl_phone-7.jpg"
    ],
    "requires": [
      "@signalk/tracks-plugin"
    ]
  },
  "version": "2.0.0-beta.1",
  "description": "Uploads the track the Signal K Tracks plugin records to noforeignland.com",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "doc/logo",
    "doc/screenshots"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility"
  ],
  "author": "Dirk Wahrheit",
  "license": "MIT",
  "homepage": "https://github.com/noforeignland/nfl-signalk",
  "bugs": {
    "url": "https://github.com/noforeignland/nfl-signalk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noforeignland/nfl-signalk.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test vite.config.ts",
    "lint:fix": "eslint src test vite.config.ts --fix",
    "format": "eslint src test vite.config.ts --fix && prettier --write \"src/**/*.ts\" \"test/**/*.ts\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eslint.json",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "cron": "^4.4.0",
    "node-fetch": "^3.3.2",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@signalk/server-api": "^2.28.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4"
  }
}
